{
  "_comment": "macOS/Linux variant of .mcp.json.example. Copy to .mcp.json and replace <checkout> with the path to your clone. CAPTURE_DIR is optional; it defaults to ./captures relative to cwd.",
  "mcpServers": {
    "picoscope": {
      "command": "<checkout>/.venv/bin/python",
      "args": ["-m", "picoscope_mcp.server"],
      "cwd": "<checkout>",
      "env": {
        "CAPTURE_DIR": "<checkout>/captures"
      }
    }
  }
}
